# Local backend server
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Required to encrypt stored GitHub/provider credentials. Generate a private
# 32-byte key and encode it as 64 hexadecimal characters.
TOKEN_ENCRYPTION_KEY=

# Optional GitHub OAuth / GitHub App settings. Required for GitHub sign-in,
# repository browsing, and persistent branch provisioning.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_ID=
# Set this to the GitHub App PEM private key in the format expected by the app.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CALLBACK_URL=http://localhost:3000/auth/github/callback
GITHUB_APP_SETUP_URL=http://localhost:3000/github/setup

# Optional settings for the separate CLI entry point (src/index.ts).
# The web app stores each user's provider credential through its Settings UI.
# Do not put real credentials in this example file.
# PROVIDER_ID=cline
# CLINE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# XAI_API_KEY=
# GROQ_API_KEY=
# MODEL_ID=
# XAI_MODEL=
# GROQ_MODEL=
