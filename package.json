{
  "name": "pocketcode",
  "version": "1.0.0",
  "description": "PocketCode - Mobile-first AI coding platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server/index.js",
    "dev": "tsx watch src/server/index.ts",
    "dev:cli": "tsx src/index.ts",
    "start:cli": "node dist/index.js",
    "smoke:groq:one-shot": "tsx scripts/groq-one-shot-smoke.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "keywords": [
    "ai",
    "coding",
    "agent"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cline/llms": "0.2.0",
    "@cline/sdk": "^0.2.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
